{% style %}
.about-section {
      max-width: 1200px;
      margin: 40px auto;
      padding: 0 20px;
    }
    .about-section h2 {
      text-align: center;
      margin-bottom: 20px;
      font-size: 2rem;
    }
    .about-content {
      display: flex;
      flex-wrap: wrap;
      gap: 30px;
      align-items: center;
    }
    .about-text {
      flex: 1 1 500px;
    }
    .about-text p {
      margin-bottom: 15px;
    }
    .about-image {
      flex: 1 1 400px;
      text-align: center;
    }
    .about-image img {
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    /* ===== Team Section ===== */
    .team {
      background: #fff;
      padding: 40px 20px;
      margin-top: 40px;
    }
    .team h2 {
      text-align: center;
      margin-bottom: 20px;
    }
    .team-members {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
      max-width: 1200px;
      margin: 0 auto;
    }
    .member {
      background: #f5f5f5;
      padding: 20px;
      border-radius: 10px;
      text-align: center;
      box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    }
    .member img {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      margin-bottom: 10px;
    }
    .member h3 {
      margin-bottom: 5px;
      font-size: 1.2rem;
    }
    .member p {
      font-size: 0.9rem;
      color: #555;
    }

    
    /* ===== Responsive ===== */
    @media (max-width: 768px) {
      .about-content {
        flex-direction: column;
      }
    }
{% endstyle %}



  <!-- About Section -->
  <section class="about-section">
    <h1>{{page.title}}</h1>
    <h2>Who We Are</h2>
    {% section 'about-section' %}
  </section>

  <!-- Team Section -->
  {% section 'team' %}

